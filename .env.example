# =====================================================================
# Aarav Image Generation API — Environment Configuration Template
# =====================================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO VERSION CONTROL.
# Use this template to configure your local (.env) or cloud hosting provider.

# ---------------------------------------------------------------------
# Operational Environment & Mode
# ---------------------------------------------------------------------
# Operational Environment: development | testing | production
ENVIRONMENT=development
DEBUG=true

# Deployment Mode: local (Mode A — Local Monolith) | hybrid (Mode B — Cloud API + Local Worker)
DEPLOYMENT_MODE=local

# ---------------------------------------------------------------------
# Database Configuration & Port Topology Split
# ---------------------------------------------------------------------
# Mode A (Default Local SQLite with WAL mode):
DATABASE_URL=sqlite+aiosqlite:///./aarav_dev.db

# Mode B — Hosted Runtime Application (Port 6543 / Supavisor Transaction Pooler):
# Multiplexes client traffic across pooled connections. Asynchronous queries use statement_cache_size=0.
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require

# Mode B — Alembic DDL Migrations (Port 5432 / Direct or Session Mode):
# Alembic DDL (CREATE/ALTER TABLE), schema inspection, and advisory locks MUST use port 5432.
# Never run Alembic against the transaction pooler on port 6543.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?ssl=require

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------
# Process Architecture & Background Task Lifespan
# ---------------------------------------------------------------------
# RUN_EMBEDDED_WORKER:
# - Set to true for Mode A local development (executes QueueWorker inside the API process).
# - MUST be set to false for cloud hosting (Render Free Web Service) to prevent running GPU inference in the cloud.
RUN_EMBEDDED_WORKER=true

# RUN_LEASE_SWEEPER:
# - Periodically reclaims abandoned or timed-out job leases.
# - Keep true on both local monolith and hosted control plane.
RUN_LEASE_SWEEPER=true

# ---------------------------------------------------------------------
# Storage Configuration
# ---------------------------------------------------------------------
# STORAGE_ADAPTER: local_cas (filesystem CAS) | remote_vault (private bucket)
STORAGE_ADAPTER=local_cas
STORAGE_BASE_PATH=./storage/images

# ---------------------------------------------------------------------
# Security & Secret Management
# ---------------------------------------------------------------------
# Cryptographic salt for API key hashing (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
API_KEY_SALT=aarav_default_development_salt_do_not_use_in_prod

# Optional master key for administrative routes
# ADMIN_API_KEY=aarav_admin_supersecretkey12345

# Shared secret for Mode B local worker authentication (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
# WORKER_SHARED_SECRET=your_64_character_hex_worker_secret_token_here

# Grace-period secret allowing zero-downtime worker secret rotation (Leave empty initially)
# WORKER_SHARED_SECRET_PREVIOUS=

# ---------------------------------------------------------------------
# Hybrid Worker Settings (Mode B On-Premise GPU Node)
# ---------------------------------------------------------------------
# Target base URL of the hosted control plane API:
# CONTROL_PLANE_URL=https://your-service-name.onrender.com

# ---------------------------------------------------------------------
# Hardware & Queue Safeguards (NVIDIA RTX 2050 Mobile 4GB VRAM Protection)
# ---------------------------------------------------------------------
LOCAL_GPU_CONCURRENCY=1
MAX_LOCAL_WIDTH=512
MAX_LOCAL_HEIGHT=512
DEFAULT_STEPS=4
MAX_STEPS=25
LEASE_TIMEOUT_SECONDS=120
MAX_JOB_RETRIES=3
WORKER_POLL_INTERVAL_SECONDS=0.5
SWEEPER_INTERVAL_SECONDS=10.0
BASE_RETRY_BACKOFF_SECONDS=2.0
MAX_RETRY_BACKOFF_SECONDS=60.0
