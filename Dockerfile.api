# =============================================================================
# Inference-1 — Cloud Control Plane API Container Specification
# =============================================================================
# Architecture: Multi-Stage Python 3.10 Slim Runtime
# Purpose: Stateless API Gateway, Telemetry, and Background Sweeper Daemons
# Security: Non-Root Execution, Minimal Surface Area, No Secrets Embedded
# Note: Heavy PyTorch/Diffusers dependencies are excluded; GPU execution occurs
#       on the dedicated on-premises hardware node.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependency Builder
# -----------------------------------------------------------------------------
FROM python:3.10-slim AS builder

WORKDIR /app

# Create isolated virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install deterministic API dependencies from verified lockfile
COPY requirements-api.lock .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements-api.lock

# -----------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# -----------------------------------------------------------------------------
FROM python:3.10-slim AS runner

WORKDIR /app

# Install runtime shared libraries and curl for container healthcheck
# Note: Standard package downloads require an approved network egress path or corporate package mirror.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root application user
RUN useradd -u 10001 -m -s /bin/bash appuser

# Copy pre-built virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Copy application source code and migration assets
COPY src/ /app/src/
COPY alembic/ /app/alembic/
COPY alembic.ini /app/alembic.ini
COPY pyproject.toml /app/pyproject.toml

# Create runtime storage directories and set non-root ownership
RUN mkdir -p /app/storage/images && chown -R appuser:appuser /app

USER appuser

# Expose control plane HTTP port
EXPOSE 8000

# Container liveness probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/liveness || exit 1

# Production ASGI server entrypoint (Single-worker enforced for lifespan daemon safety)
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "15"]
